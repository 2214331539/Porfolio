PORT=4318

# Keep the encrypted vault outside the repository. On the production server,
# copy vault.enc, master.key and the snapshot files into this directory.
SERVER_DECK_DATA_DIR=/home/pp/.server-deck

# Must be the same value as Porfolio backend SECRET_KEY so the embedded panel
# can accept the Porfolio admin JWT from localStorage.
PORFOLIO_JWT_SECRET=replace-with-the-porfolio-secret-key
SERVER_DECK_ALLOWED_HOSTS=shorpan.cyou,www.shorpan.cyou,127.0.0.1,localhost,[::1]
SERVER_DECK_ALLOWED_ORIGINS=https://shorpan.cyou,https://www.shorpan.cyou,http://127.0.0.1:5173,http://localhost:5173
SERVER_DECK_SECURE_COOKIE=1
